# Neon Serverless PostgreSQL connection strings.
# Obtain from your Neon Console (https://console.neon.tech) or `neon link`.
# DATABASE_URL: pooled (-pooler) endpoint, used by the running app.
# DATABASE_URL_UNPOOLED: direct endpoint, required by `prisma migrate`.
DATABASE_URL="postgresql://neondb_owner:YOUR_PASSWORD@ep-example-123456-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require"
DATABASE_URL_UNPOOLED="postgresql://neondb_owner:YOUR_PASSWORD@ep-example-123456.us-east-2.aws.neon.tech/neondb?sslmode=require"

# Isolated Neon branch used only by `npm test` (scripts/verify-domain-rules.ts)
# so the domain test suite never writes into real production data.
# Create one with: neon branches create --name test --parent production
TEST_DATABASE_URL="postgresql://neondb_owner:YOUR_PASSWORD@ep-example-test-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require"
TEST_DATABASE_URL_UNPOOLED="postgresql://neondb_owner:YOUR_PASSWORD@ep-example-test.us-east-2.aws.neon.tech/neondb?sslmode=require"

# Signing key for the httpOnly session cookie. Generate with: openssl rand -base64 32
SESSION_SECRET="your-random-secret"

# Seeds a single ADMIN account on first boot if no ADMIN user exists yet.
# Safe to leave set permanently -- once an admin exists, this is a no-op.
# Login is username-based; ADMIN_EMAIL is optional contact info only.
ADMIN_USERNAME="admin"
ADMIN_PASSWORD="choose-a-strong-password"
ADMIN_EMAIL="admin@nibm.lk"
