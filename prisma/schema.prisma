datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_URL_UNPOOLED")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  ADMIN
  DEMONSTRATOR
  EXECUTIVE
  INSTRUCTOR
  GUEST
}

enum RosterStatus {
  DRAFT
  PUBLISHED
}

enum LeaveStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

model User {
  id                 String   @id @default(uuid())
  fullName           String
  email              String   @unique
  role               Role     @default(INSTRUCTOR)
  phone              String?
  avatarColor        String?  @default("indigo")
  isActive           Boolean  @default(true)
  passwordHash       String
  mustChangePassword Boolean  @default(false)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  dutyAssignments DutyAssignment[]
  nightShifts     NightShift[]
  leaveRequests   LeaveRequest[] @relation("InstructorLeaves")
  approvedLeaves  LeaveRequest[] @relation("ReviewerLeaves")
  publishedWeeks  RosterWeek[]   @relation("PublishedWeeks")
  auditLogs       AuditLog[]
}

// Dates below (startDate/endDate/dutyDate/shiftDate) are deliberately plain
// "YYYY-MM-DD" strings, not DateTime columns. The whole app compares and
// sorts these lexicographically as strings; storing them as DateTime would
// reintroduce timezone-shift bugs and require rewriting that logic everywhere.
model RosterWeek {
  id            String       @id @default(uuid())
  startDate     String
  endDate       String
  status        RosterStatus @default(DRAFT)
  publishedAt   DateTime?
  publishedById String?
  publishedBy   User?        @relation("PublishedWeeks", fields: [publishedById], references: [id])
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  dutyAssignments DutyAssignment[]
  nightShifts     NightShift[]

  @@unique([startDate, endDate])
}

model DutyAssignment {
  id           String     @id @default(uuid())
  rosterWeekId String
  rosterWeek   RosterWeek @relation(fields: [rosterWeekId], references: [id], onDelete: Cascade)
  instructorId String
  instructor   User       @relation(fields: [instructorId], references: [id], onDelete: Cascade)
  dutyDate     String
  slotLabel    String
  startTime    String
  endTime      String
  batchName    String
  moduleName   String
  roomLab      String?
  notes        String?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@unique([dutyDate, startTime, instructorId])
}

model NightShift {
  id           String     @id @default(uuid())
  rosterWeekId String
  rosterWeek   RosterWeek @relation(fields: [rosterWeekId], references: [id], onDelete: Cascade)
  instructorId String
  instructor   User       @relation(fields: [instructorId], references: [id], onDelete: Cascade)
  shiftDate    String
  notes        String?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  // Exactly one night-duty officer per date -- setNightShift() replaces
  // whoever previously held that date rather than adding a second row.
  @@unique([shiftDate])
}

model LeaveRequest {
  id            String      @id @default(uuid())
  instructorId  String
  instructor    User        @relation("InstructorLeaves", fields: [instructorId], references: [id], onDelete: Cascade)
  startDate     String
  endDate       String
  reason        String
  status        LeaveStatus @default(PENDING)
  reviewedById  String?
  reviewedBy    User?       @relation("ReviewerLeaves", fields: [reviewedById], references: [id])
  reviewedAt    DateTime?
  reviewComment String?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
}

model AuditLog {
  id           String   @id @default(uuid())
  userId       String?
  user         User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action       String
  targetEntity String
  targetId     String?
  metadata     String?
  createdAt    DateTime @default(now())
}

// Singleton row (id is always "singleton") holding the dynamic academic
// catalog of student batches and lecture rooms/labs.
model Catalog {
  id      String   @id @default("singleton")
  batches String[]
  rooms   String[]
}
